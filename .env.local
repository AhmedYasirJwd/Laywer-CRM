# Supabase project — safe to keep these two values here; they're the public
# "anon/publishable" key, meant to ship in the browser bundle. Real security
# comes from Postgres Row Level Security (see supabase/schema.sql), not from
# keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://rhgxjyzsornzzkeqgwxk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_e9ydehmEBB2USPR1FSmYEQ_Fp9-hKXj

# Used to build the email-confirmation link Supabase sends on sign-up.
# Set this to your real deployed URL once you have one (e.g. https://your-app.vercel.app).
# Leave as localhost for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Service role key (Supabase Dashboard → Project Settings → API → service_role).
# Server-only — bypasses Row Level Security. Used exclusively by the
# notifications cron job (src/app/api/cron/notifications) to check every
# user's hearings/tasks, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJoZ3hqeXpzb3JuenprZXFnd3hrIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Njc5Njk3OSwiZXhwIjoyMTAyMzcyOTc5fQ.Je_Sa2LozYfjMadL35yN2A3gnT7cP2clbROnAXISl7I

# Push notifications (hearing/task reminders). Generate a keypair with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose to the browser (NEXT_PUBLIC_ prefix); the
# private key is not — keep it server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJD4-lExyPDV5j-GPvUHY-_-8MR_jiFvkTen9GYDxHxqMg7Oxr9njqJe5_X7FykCgD6tMNUTo6rMfn88cumentY
VAPID_PRIVATE_KEY=CZuro50mEyMx2MyJRrBNxK4qOVsEwQmIMWq7whPQ830
# Contact address the push service can reach you at if it needs to (required
# by the Web Push spec). A mailto: link is fine.
VAPID_SUBJECT=mailto:ahmedyasirjwd@gmail.com

# Shared secret that authorizes calls to /api/cron/notifications. Vercel Cron
# automatically sends this as `Authorization: Bearer <CRON_SECRET>` for jobs
# defined in vercel.json — set the same value here and in your Vercel project's
# environment variables. Generate one with: openssl rand -hex 32
CRON_SECRET=ahmedyasirjwd
ADMIN_EMAILS=ahmedyasirjwd@gmail.com